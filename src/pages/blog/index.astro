---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostListItem from '../../components/PostListItem.astro';
import { SITE_DESCRIPTION, SITE_TITLE, CATEGORIES } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = posts.slice(0, 3);

const allSubs = await getCollection('subcategories');

// カテゴリごとの「最新3件 + サブカテゴリチップ」
const sections = CATEGORIES.map((c) => ({
	...c,
	posts: posts.filter((post) => post.data.category === c.slug).slice(0, 3),
	total: posts.filter((post) => post.data.category === c.slug).length,
	subs: allSubs
		.filter((s) => s.data.category === c.slug)
		.sort((a, b) => (a.data.order - b.data.order) || a.data.label.localeCompare(b.data.label, 'ja')),
}));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: #f9f9f9;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
				font-family: var(--font-jp);
			}
			.blog-header {
				text-align: center;
				margin-bottom: 3rem;
				padding: 2rem;
				background: linear-gradient(135deg, #bdf1f6 0%, #fff 100%);
				border-radius: 15px;
				border: 2px dashed #8be0e8;
			}
			.blog-header h1 {
				margin: 0;
				color: #555;
			}
			.category-section {
				background: #fff;
				padding: 2rem;
				border-radius: 15px;
				border: 4px solid #fecfef;
				margin-bottom: 3rem;
				box-shadow: 0 4px 10px rgba(0,0,0,0.05);
			}

			.section-title {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 2px dashed #eee;
				padding-bottom: 1rem;
				margin-top: 0;
				margin-bottom: 1.5rem;
			}
			.section-title h2 {
				margin: 0;
				font-size: 1.8em;
				color: #333;
			}
			.section-title h2 .count {
				color: #999;
				font-size: 0.6em;
				font-weight: normal;
			}
			.section-title a {
				text-decoration: none;
				color: #ff9a9e;
				font-weight: bold;
				transition: color 0.2s;
				padding: 0.5rem 1rem;
				background: #fff0f1;
				border-radius: 20px;
				white-space: nowrap;
			}
			.section-title a:hover {
				color: #ff7479;
				background: #ffe3e5;
			}
			/* サブカテゴリのチップ */
			.sub-chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: -0.5rem 0 1.2rem 0;
			}
			.sub-chips a {
				display: inline-block;
				padding: 0.25rem 0.9rem;
				background: #f4fdff;
				border: 2px solid var(--cyan);
				border-radius: 999px;
				color: #333;
				font-weight: bold;
				font-size: 0.85em;
				text-decoration: none;
				transition: all 0.2s;
			}
			.sub-chips a:hover {
				background: #fff;
				border-color: var(--cyan-deep);
				box-shadow: 0 4px 8px rgba(139, 224, 232, 0.3);
			}

			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.archive-link {
				text-align: center;
				margin-top: 1.5rem;
			}
			.archive-link a {
				display: inline-block;
				padding: 0.6rem 1.6rem;
				background: #fff0f1;
				border-radius: 20px;
				color: #ff9a9e;
				font-weight: bold;
				text-decoration: none;
				transition: all 0.2s;
			}
			.archive-link a:hover {
				color: #ff7479;
				background: #ffe3e5;
			}
			@media (max-width: 720px) {
				.section-title {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.6rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-header">
				<h1>📝 ブログ記事一覧</h1>
				<p>カテゴリーごとに最新の記事をチェックできます！</p>
			</section>

			<section class="category-section">
				<div class="section-title">
					<h2>✨ 最近の記事</h2>
					<a href="/archive/">📚 全記事アーカイブ ❯</a>
				</div>
				<ul class="post-list">
					{recentPosts.map((post) => (
						<PostListItem post={post} showCategory={true} />
					))}
				</ul>
			</section>

			{sections.map((sec) => sec.posts.length > 0 && (
				<section class="category-section" style={`border-color: ${sec.color}`}>
					<div class="section-title">
						<h2>{sec.emoji} {sec.label} <span class="count">({sec.total}件)</span></h2>
						<a href={`/category/${sec.slug}/`}>もっと見る ❯</a>
					</div>
					{sec.subs.length > 0 && (
						<div class="sub-chips">
							{sec.subs.map((s) => (
								<a href={`/category/${sec.slug}/${s.data.slug}/`}>{s.data.label}</a>
							))}
						</div>
					)}
					<ul class="post-list">
						{sec.posts.map((post) => (
							<PostListItem post={post} />
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
