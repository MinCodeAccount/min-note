---
import { SITE_TITLE, CATEGORIES } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getCollection } from 'astro:content';

// サブカテゴリを親カテゴリごとにまとめる（ドロップダウン表示用）
const subsByCat: Record<string, { slug: string; label: string; order: number }[]> = {};
for (const s of await getCollection('subcategories')) {
	(subsByCat[s.data.category] ??= []).push(s.data);
}
for (const k of Object.keys(subsByCat)) {
	subsByCat[k].sort((a, b) => (a.order - b.order) || a.label.localeCompare(b.label, 'ja'));
}
---

<header>
	<nav>
		<h2 class="site-title"><a href="/">{SITE_TITLE}</a></h2>
		<ul class="internal-links">
			<li><HeaderLink href="/">ホーム</HeaderLink></li>
			<li><HeaderLink href="/blog/">ブログ</HeaderLink></li>
			{CATEGORIES.map((c) => {
				const subs = subsByCat[c.slug] ?? [];
				return (
					<li class={subs.length ? 'has-dropdown' : ''}>
						<HeaderLink href={`/category/${c.slug}/`}>
							{c.emoji} {c.label}{subs.length > 0 && <span class="caret" aria-hidden="true">▾</span>}
						</HeaderLink>
						{subs.length > 0 && (
							<ul class="dropdown">
								{subs.map((s) => (
									<li>
										<a href={`/category/${c.slug}/${s.slug}/`}>{s.label}</a>
									</li>
								))}
							</ul>
						)}
					</li>
				);
			})}
			<li><HeaderLink href="/about/">プロフィール</HeaderLink></li>
		</ul>
		<form class="header-search" action="/search/" method="get" role="search">
			<input type="search" name="q" placeholder="記事・株価を検索" aria-label="サイト内を検索" autocomplete="off" />
			<button type="submit" aria-label="検索する">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
						d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm5 12 4 4" />
				</svg>
			</button>
		</form>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: relative;
		z-index: 50;
	}
	h2.site-title {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}
	h2.site-title a,
	h2.site-title a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.2em;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		list-style: none;
		margin: 0;
		padding: 0;
		column-gap: 0.1em;
	}
	.internal-links > li {
		position: relative;
	}
	nav a {
		display: inline-block;
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.caret {
		font-size: 0.7em;
		margin-left: 0.15em;
		color: var(--cyan-deep);
		vertical-align: middle;
	}

	/* === サブカテゴリのドロップダウン === */
	.dropdown {
		position: absolute;
		top: 100%;
		left: 0.5em;
		min-width: 170px;
		list-style: none;
		margin: 0;
		padding: 0.4rem 0;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-top: 3px solid var(--cyan-deep);
		border-radius: 0 0 12px 12px;
		box-shadow: 0 10px 22px rgba(var(--gray), 30%);
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		transition: opacity 0.15s ease, transform 0.15s ease;
		z-index: 100;
	}
	.has-dropdown:hover > .dropdown,
	.has-dropdown:focus-within > .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown li {
		margin: 0;
	}
	.dropdown a {
		display: block;
		padding: 0.55rem 1.2rem;
		border-bottom: none;
		font-size: 0.95rem;
		font-weight: bold;
		color: #444;
		white-space: nowrap;
	}
	.dropdown a:hover {
		background: #f4fdff;
		color: var(--accent);
	}

	/* === ヘッダー検索ボックス === */
	.header-search {
		margin-left: auto;
		display: flex;
		align-items: center;
		background: #f4f6f8;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		padding: 0 0.3em 0 0.9em;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.header-search:focus-within {
		border-color: var(--cyan-deep);
		box-shadow: 0 0 0 3px rgba(139, 224, 232, 0.3);
		background: #fff;
	}
	.header-search input {
		border: none;
		background: transparent;
		outline: none;
		font-size: 0.9rem;
		padding: 0.5em 0;
		width: 150px;
		font-family: var(--font-jp);
		color: var(--black);
	}
	.header-search button {
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		padding: 0.3em;
		border-radius: 50%;
	}
	.header-search button:hover {
		color: var(--accent);
	}

	@media (max-width: 960px) {
		nav {
			flex-wrap: wrap;
			gap: 0;
			padding-bottom: 0.5em;
		}
		h2.site-title {
			width: 100%;
			text-align: center;
			padding: 0.8em 0 0.3em;
		}
		.internal-links {
			width: 100%;
			justify-content: center;
		}
		nav a {
			padding: 0.5em 0.4em;
			font-size: 0.9em;
			border-bottom-width: 3px;
		}
		/* モバイルはホバー不可のため、ドロップダウンは各カテゴリ下に常時展開 */
		.has-dropdown {
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.dropdown {
			position: static;
			opacity: 1;
			visibility: visible;
			transform: none;
			box-shadow: none;
			border: none;
			border-radius: 0;
			padding: 0;
			min-width: 0;
			display: flex;
			gap: 0.2em;
			background: transparent;
		}
		.dropdown a {
			padding: 0.1em 0.6em;
			font-size: 0.8rem;
			font-weight: normal;
			color: var(--accent);
			background: #f4fdff;
			border-radius: 999px;
			margin-bottom: 0.3em;
		}
		.caret {
			display: none;
		}
		.header-search {
			width: 100%;
			margin: 0.3em 0 0;
			box-sizing: border-box;
		}
		.header-search input {
			width: 100%;
			flex-grow: 1;
		}
	}
</style>
