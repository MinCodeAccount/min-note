---
import { SITE_TITLE, CATEGORIES } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/blog/">ブログ</HeaderLink>
			{CATEGORIES.map((c) => (
				<HeaderLink href={`/category/${c.slug}/`}>{c.emoji} {c.label}</HeaderLink>
			))}
			<HeaderLink href="/search/">🔍 検索</HeaderLink>
			<HeaderLink href="/about/">プロフィール</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://x.com/mikan56230" target="_blank" rel="noopener">
				<span class="sr-only">Follow on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 0.2em;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		margin-left: auto;
	}
	@media (max-width: 960px) {
		.social-links {
			display: none;
		}
		nav {
			flex-wrap: wrap;
			gap: 0;
			padding-bottom: 0.3em;
		}
		nav a {
			padding: 0.5em 0.4em;
			font-size: 0.9em;
			border-bottom-width: 3px;
		}
		h2 {
			width: 100%;
			text-align: center;
			padding: 0.8em 0 0.3em;
		}
		.internal-links {
			width: 100%;
			justify-content: center;
		}
	}
</style>
