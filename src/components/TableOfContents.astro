---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter to only include h2 and h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// If no headings, don't render anything
if (toc.length === 0) {
  return '';
}
---

<div class="toc-container">
	<details open class="toc-details">
		<summary class="toc-title">目次 (Table of Contents)</summary>
		<ul class="toc-list">
			{
				toc.map((heading) => (
					<li class={`toc-item depth-${heading.depth}`}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))
			}
		</ul>
	</details>
</div>

<style>
	.toc-container {
		background-color: #e5ffff; /* User requested light cyan color */
		border: 1px solid var(--gray-line, #e9ecef);
		border-radius: 8px;
		padding: 1.5rem 2rem;
		margin: 2rem 0 3rem 0;
		box-shadow: none; /* remove deep shadow for a flatter modern look */
		transition: all 0.3s ease;
		color: rgb(var(--gray-dark));
	}
	
	.toc-container:hover {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
	}

  /* Dark mode support if available */
  @media (prefers-color-scheme: dark) {
    .toc-container {
      background-color: transparent; /* "Design B" for dark mode: transparent with border */
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: none;
      color: #e2e8f0; /* light text for dark mode */
    }
    .toc-container:hover {
		box-shadow: none;
		border: 1px solid rgba(255, 255, 255, 0.25);
	}
    .toc-item a {
      color: #cbd5e1; /* ensure links are light colored in dark mode */
    }
    .toc-item a:hover {
      color: #818cf8; /* slightly brighter accent hover */
    }
    .toc-details summary {
      color: #f8fafc; /* slightly brighter for the summary heading */
    }
    .toc-item.depth-3::before {
      color: #475569; /* adjust the bullet color specifically for dark mode */
    }
  }

	.toc-details summary {
		font-weight: 600;
		font-size: 1.2rem;
		cursor: pointer;
		margin-bottom: 1.5rem; /* Increased margin below title */
		list-style: none; /* Hide default arrow in some browsers */
		display: flex;
		align-items: center;
		user-select: none;
		color: rgb(var(--black));
	}

	.toc-details summary::-webkit-details-marker {
		display: none; /* Hide default arrow in Safari */
	}

	.toc-details summary::before {
		content: '▼';
		font-size: 0.8rem;
		margin-right: 0.5rem;
		transition: transform 0.2s ease;
		color: var(--accent, #6366f1);
	}

	.toc-details:not([open]) summary::before {
		transform: rotate(-90deg);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-item {
		margin: 0.6rem 0; /* slightly wider lines */
	}

	/* Indent h3 under h2 */
	.toc-item.depth-3 {
		padding-left: 1.5rem;
		font-size: 0.95em;
	}
	
	.toc-item.depth-3::before {
		content: '↳';
		margin-right: 0.5rem;
		font-weight: bold;
		color: #000000; /* User requested black marker */
	}

	/* Style Links */
	.toc-item a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: color 0.2s;
	}

	.toc-item a:hover {
		color: var(--accent, #6366f1);
		text-decoration: underline;
	}
</style>
