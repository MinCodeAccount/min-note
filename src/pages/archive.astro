---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ChangeBadge from '../components/ChangeBadge.astro';
import { SITE_TITLE, getCategory } from '../consts';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 「2026年7月」のような月見出しでグルーピング（新しい月から）
const months: { key: string; posts: typeof posts }[] = [];
for (const post of posts) {
	const d = post.data.pubDate;
	const key = `${d.getFullYear()}年${d.getMonth() + 1}月`;
	const last = months[months.length - 1];
	if (last && last.key === key) {
		last.posts.push(post);
	} else {
		months.push({ key, posts: [post] });
	}
}
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`全記事アーカイブ - ${SITE_TITLE}`} description="これまでの全記事を月別・時系列で一覧できます。" />
		<style>
			main {
				width: 960px;
				max-width: 100%;
				margin: 0 auto;
				padding: 2rem;
				font-family: var(--font-jp);
			}
			.archive-header {
				text-align: center;
				margin-bottom: 2.5rem;
				padding: 2rem;
				background: linear-gradient(135deg, #fdfbf7 0%, #fff 100%);
				border-radius: 15px;
				border: 2px dashed #bdf1f6;
			}
			.archive-header h1 {
				margin: 0;
				color: #555;
			}
			.archive-header .count {
				color: #999;
				font-size: 0.95em;
			}
			.month-section {
				margin-bottom: 2.5rem;
			}
			.month-section h2 {
				font-size: 1.4em;
				color: #444;
				border-bottom: 2px dashed #eee;
				padding-bottom: 0.6rem;
				margin-bottom: 1rem;
			}
			.month-section h2 .count {
				color: #999;
				font-size: 0.75em;
				font-weight: normal;
			}
			.archive-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}
			.archive-list li {
				background: #fff;
				border: 1px solid #eee;
				border-radius: 10px;
				transition: all 0.2s;
			}
			.archive-list li:hover {
				transform: translateX(4px);
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
				border-color: var(--cyan-deep);
			}
			.archive-list a.post-link {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.8rem 1rem;
				text-decoration: none;
				color: #333;
			}
			.a-date {
				color: #888;
				font-size: 0.85em;
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
			}
			.a-title {
				flex-grow: 1;
				font-weight: bold;
				line-height: 1.4;
			}
			.a-category {
				font-size: 0.8em;
				padding: 0.05rem 0.7rem;
				border: 1px solid;
				border-radius: 999px;
				color: #555;
				white-space: nowrap;
			}
			@media (max-width: 720px) {
				.archive-list a.post-link {
					flex-wrap: wrap;
				}
				.a-title {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-header">
				<h1>📚 全記事アーカイブ</h1>
				<p class="count">全 {posts.length} 件を月別に一覧できます</p>
			</section>

			{months.map((month) => (
				<section class="month-section">
					<h2>{month.key} <span class="count">({month.posts.length}件)</span></h2>
					<ul class="archive-list">
						{month.posts.map((post) => {
							const cat = getCategory(post.data.category);
							return (
								<li>
									<a class="post-link" href={`/blog/${post.id}/`}>
										<span class="a-date"><FormattedDate date={post.data.pubDate} /></span>
										{post.data.change && <ChangeBadge change={post.data.change} />}
										<span class="a-title">{post.data.title}</span>
										{cat && (
											<span class="a-category" style={`background: ${cat.color}55; border-color: ${cat.color}`}>
												{cat.emoji} {cat.label}
											</span>
										)}
									</a>
								</li>
							);
						})}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
