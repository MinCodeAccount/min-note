---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
// Pagefind のUI/インデックスは build 後に dist/pagefind/ に生成される
// （dev では存在しないため、確認は build → preview で行う）
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`検索 - ${SITE_TITLE}`} description="サイト内の記事を全文検索できます。" />
		<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2rem 1em 3rem;
				font-family: var(--font-jp);
			}
			.search-header {
				text-align: center;
				margin-bottom: 2rem;
				padding: 2rem;
				background: linear-gradient(135deg, #bdf1f6 0%, #fff 100%);
				border-radius: 15px;
				border: 2px dashed #8be0e8;
			}
			.search-header h1 {
				margin: 0;
				color: #555;
				font-size: 2em;
			}
			.search-header p {
				color: #777;
				margin: 0.5rem 0 0 0;
			}
			.search-box {
				background: #fff;
				padding: 1.5rem 2rem 2rem;
				border-radius: 15px;
				border: 2px solid #eee;
			}
			/* Pagefind UI をサイトのテーマ色に合わせる */
			#search {
				--pagefind-ui-primary: var(--accent);
				--pagefind-ui-text: rgb(var(--gray-dark));
				--pagefind-ui-border: rgb(var(--gray-light));
				--pagefind-ui-border-radius: 12px;
				--pagefind-ui-font: var(--font-jp);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="search-header">
				<h1>🔍 記事を検索</h1>
				<p>キーワードで過去の記事を探せます（例: 転スラ、日経平均、ポケモン）</p>
			</section>
			<div class="search-box">
				<div id="search"></div>
			</div>
		</main>
		<Footer />
		<script is:inline src="/pagefind/pagefind-ui.js"></script>
		<script is:inline>
			window.addEventListener('DOMContentLoaded', () => {
				if (typeof PagefindUI === 'undefined') return;
				const ui = new PagefindUI({
					element: '#search',
					showImages: false,
					showSubResults: true,
					pageSize: 10,
					translations: {
						placeholder: '記事・株価を検索',
						clear_search: 'クリア',
						load_more: 'さらに表示',
						search_label: 'サイト内を検索',
						filters_label: '絞り込み',
						zero_results: '「[SEARCH_TERM]」に一致する記事は見つかりませんでした',
						many_results: '「[SEARCH_TERM]」の検索結果: [COUNT]件',
						one_result: '「[SEARCH_TERM]」の検索結果: [COUNT]件',
						alt_search: '「[SEARCH_TERM]」の結果がないため「[DIFFERENT_TERM]」の結果を表示しています',
						search_suggestion: '「[SEARCH_TERM]」に一致する記事はありません。別のキーワードをお試しください',
						searching: '「[SEARCH_TERM]」を検索中…',
					},
				});
				// ヘッダーの検索ボックスから ?q= 付きで来たら自動で検索を実行
				const q = new URLSearchParams(window.location.search).get('q');
				if (q) {
					ui.triggerSearch(q);
					const input = document.querySelector('#search input');
					if (input) input.focus();
				}
			});
		</script>
	</body>
</html>
