---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostListItem from '../components/PostListItem.astro';
import { SITE_DESCRIPTION, SITE_TITLE, CATEGORIES } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.slice(0, 3);

// カテゴリごとの記事数（0件のカテゴリもリンクは表示する）
const categoryStats = CATEGORIES.map((c) => ({
	...c,
	count: allPosts.filter((p) => p.data.category === c.slug).length,
}));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: #f9f9f9;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
				font-family: var(--font-jp);
			}
			.hero {
				background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
				border-radius: 20px;
				padding: 3rem 2rem;
				text-align: center;
				color: #fff;
				box-shadow: 0 10px 20px rgba(255, 154, 158, 0.3);
				margin-bottom: 3rem;
				animation: float 6s ease-in-out infinite;
			}
			@keyframes float {
				0% { transform: translateY(0px); }
				50% { transform: translateY(-10px); }
				100% { transform: translateY(0px); }
			}
			.hero h1 {
				margin: 0;
				font-size: 2.5em;
				color: white;
				text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
			}
			.hero p {
				font-size: 1.2em;
				margin-top: 1rem;
				color: white;
				text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
				opacity: 0.95;
			}

			.features {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin-bottom: 3rem;
			}
			.card {
				background: #fff;
				border: 4px solid #bdf1f6;
				border-radius: 15px;
				padding: 2rem;
				text-align: center;
				transition: transform 0.3s, box-shadow 0.3s;
				text-decoration: none;
				color: inherit;
				display: block;
			}
			a.card:hover {
				transform: translateY(-5px) scale(1.02);
				box-shadow: 0 8px 15px rgba(189, 241, 246, 0.5);
				border-color: #8be0e8;
			}
			.card h2 {
				color: #555;
				margin-top: 0;
			}
			.card p {
				color: #777;
			}
			.card.yellow {
				border-color: #fff3b0;
			}
			a.card.yellow:hover {
				box-shadow: 0 8px 15px rgba(255, 243, 176, 0.5);
				border-color: #ffe45e;
			}

			.category-list {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 0 0;
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
			}
			.category-list li a {
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: #f4fdff;
				padding: 0.8rem;
				border-radius: 10px;
				text-decoration: none;
				color: #333;
				font-weight: bold;
				transition: all 0.2s;
				border: 2px solid transparent;
			}
			.category-list li a:hover {
				background: #fff;
				border-color: #8be0e8;
				transform: translateX(5px);
				box-shadow: 0 4px 8px rgba(139, 224, 232, 0.3);
			}
			.category-list .cat-count {
				color: #999;
				font-weight: normal;
				font-size: 0.9em;
			}

			.recent-posts {
				background: #fdfbf7;
				padding: 2rem;
				border-radius: 15px;
				border: 2px dashed #ffc6c7;
			}
			.recent-posts h2 {
				color: #ff9a9e;
				text-align: center;
				margin-top: 0;
				font-size: 1.8em;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.archive-link {
				text-align: center;
				margin-top: 1.5rem;
			}
			.archive-link a {
				display: inline-block;
				padding: 0.6rem 1.6rem;
				background: #fff0f1;
				border-radius: 20px;
				color: #ff9a9e;
				font-weight: bold;
				text-decoration: none;
				transition: all 0.2s;
			}
			.archive-link a:hover {
				color: #ff7479;
				background: #ffe3e5;
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>🎉 みんの日常へようこそ！ 🎉</h1>
				<p>日々の出来事や、お気に入りのガジェット、ふと思ったことなどをゆる〜く発信しています。</p>
			</section>

			<section class="features">
				<div class="card blog-card">
					<h2>📝 ブログカテゴリ</h2>
					<ul class="category-list">
						{categoryStats.map((c) => (
							<li>
								<a href={`/category/${c.slug}/`}>
									<span>{c.emoji} {c.label}</span>
									<span class="cat-count">{c.count}件</span>
								</a>
							</li>
						))}
					</ul>
				</div>
				<a href={`/about`} class="card yellow">
					<h2>🙋‍♀️ 私について</h2>
					<p>プロフィールや趣味についてはこちら。</p>
				</a>
			</section>

			<section class="recent-posts">
				<h2>✨ 最近の更新 ✨</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<PostListItem post={post} showCategory={true} />
					))}
				</ul>
				<div class="archive-link">
					<a href="/archive/">📚 すべての記事を見る ❯</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
